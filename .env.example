# WDK + Observer Protocol Environment Configuration

# WDK Configuration
WDK_NETWORK=testnet
WDK_EVM_PROVIDER=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
WDK_BTC_PROVIDER=https://blockstream.info/testnet/api

# Observer Protocol
OBSERVER_ENDPOINT=https://api.observerprotocol.org
OBSERVER_API_KEY=optional_api_key_here

# Agent Identity
AGENT_ID=your-agent-001
AGENT_ALIAS=Your Agent Name

# Wallet Security (generate a strong key)
ENCRYPTION_KEY=your-256-bit-encryption-key-here

# Optional: Custom logging
LOG_LEVEL=info
