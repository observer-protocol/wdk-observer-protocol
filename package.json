{
  "name": "@observer-protocol/monorepo",
  "version": "1.0.0",
  "description": "Observer Protocol - Verified agent-to-agent payments with cryptographic identity",
  "type": "module",
  "main": "core/index.mjs",
  "scripts": {
    "start": "node core/index.mjs",
    "example:basic": "node demo/basic-wallet.mjs",
    "example:verified": "node demo/verified-send.mjs",
    "example:agent": "node demo/agent-to-agent.mjs",
    "test": "node test/integration.mjs",
    "mcp": "node core/mcp-server.mjs",
    "celo:compile": "cd rails/celo && npm run compile",
    "celo:deploy": "cd rails/celo && npm run deploy"
  },
  "keywords": [
    "observer-protocol",
    "ai-agent",
    "identity",
    "verification",
    "payments",
    "bitcoin",
    "ethereum",
