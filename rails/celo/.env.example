# Celo Rail Environment Variables

# Celo Private Key (with 0x prefix)
CELO_PRIVATE_KEY=your_private_key_here

# Celo RPC URL
CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# Chain ID (11142220 for Celo Sepolia, 42220 for Mainnet)
CHAIN_ID=11142220

# CeloScan API Key for verification
CELOSCAN_API_KEY=your_celoscan_api_key_here

# Deployed Contract Addresses (populated after deployment)
AGENT_IDENTITY_REGISTRY_ADDRESS=
AGENT_REPUTATION_REGISTRY_ADDRESS=
AGENT_STAKING_ADDRESS=

# cUSD Token Address on Alfajores
CUSD_TOKEN_ADDRESS=0x2F25deB3848C207fc8E0c34035B3Ba7f1579A842
